{
  "tokens": {
    "colors": {
      "--color-1": "#333333",
      "--color-2": "#555555",
      "--color-primary": "#3b82f6",
      "--color-4": "#ffffff",
      "--color-5": "#ff0000",
      "--color-6": "#888888"
    },
    "spacing": [
      8,
      13,
      16
    ],
    "fontSizes": [
      14
    ],
    "fontFamilies": [
      "Inter"
    ],
    "radii": [
      4
    ]
  },
  "rules": {
    "no-hardcoded-color": "error",
    "no-arbitrary-spacing": "error",
    "no-arbitrary-font-size": "error",
    "no-unauthorized-font-family": "error",
    "no-arbitrary-radius": "error",
    "enforce-contrast": "error",
    "no-img-without-alt": "error",
    "no-div-button": "warn",
    "no-empty-button": "error",
    "no-missing-form-label": "error",
    "no-positive-tabindex": "warn",
    "no-autofocus": "warn",
    "no-xss-dangerous": "error",
    "no-env-in-client": "error",
    "no-console-sensitive": "warn",
    "no-hardcoded-credentials": "error"
  },
  "wcag": {
    "level": "AA"
  },
  "ignore": [
    "node_modules/**",
    "dist/**",
    "build/**",
    ".next/**",
    ".turbo/**",
    "coverage/**",
    "**/*.min.js",
    "**/*.min.css",
    "**/*.d.ts",
    "**/*.test.*",
    "**/*.spec.*",
    "public/**"
  ],
  "baseline": {
    "enabled": true
  }
}
