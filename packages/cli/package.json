{
  "name": "@uiseal/cli",
  "version": "0.2.0",
  "description": "CLI and interactive TUI for uiseal — design-system enforcement for AI-generated code. Checks CSS, JSX, Vue, Angular, Svelte, and backend templates against your design tokens.",
  "keywords": [
    "design-system",
    "linter",
    "cli",
    "tokens",
    "design-tokens",
    "css",
    "scss",
    "vue",
    "angular",
    "svelte",
    "tailwind",
    "tailwindcss",
    "drift",
    "sarif",
    "accessibility"
  ],
  "license": "Elastic-2.0",
  "type": "module",
  "bin": {
    "uiseal": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vitygo/uiseal-engine"
  },
  "homepage": "https://uiseal.io",
  "bugs": {
    "url": "https://github.com/vitygo/uiseal-engine/issues"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "@types/react": "^19.2.17",
    "@uiseal/core": "workspace:*",
    "chokidar": "^5.0.0",
    "commander": "^12.0.0",
    "dotenv": "^17.4.2",
    "glob": "^11.0.0",
    "ink": "^7.1.0",
    "micromatch": "^4.0.8",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.10",
    "@types/node": "^20.0.0",
    "tsup": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
