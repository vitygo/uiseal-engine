{
  "name": "@uiseal/core",
  "version": "0.2.0",
  "description": "Design-system enforcement engine for AI-generated code — parses CSS, SCSS, LESS, JSX, Vue, Angular, Svelte, and backend templates and checks them against your design tokens.",
  "keywords": [
    "design-system",
    "linter",
    "static-analysis",
    "tokens",
    "design-tokens",
    "css",
    "scss",
    "less",
    "tailwind",
    "tailwindcss",
    "vue",
    "angular",
    "svelte",
    "react",
    "accessibility",
    "a11y",
    "drift",
    "sarif"
  ],
  "license": "Elastic-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vitygo/uiseal-engine"
  },
  "homepage": "https://uiseal.io",
  "bugs": {
    "url": "https://github.com/vitygo/uiseal-engine/issues"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.61.0",
    "@vue/compiler-core": "^3.5.39",
    "@vue/compiler-sfc": "^3.5.39",
    "culori": "^3.3.0",
    "glob": "^11.0.0",
    "micromatch": "^4.0.8",
    "postcss": "^8.5.15",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.9",
    "svelte": "^5.56.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.10",
    "@types/node": "^20.0.0",
    "ajv": "^8.20.0",
    "tsup": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
